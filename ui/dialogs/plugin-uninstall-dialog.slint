import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action-button.slint";

/// 插件卸载确认：只删除插件包与注册信息，不删除 agent 会话数据。
export component PluginUninstallDialog inherits Rectangle {
    in property <length> overlay-width: 1080px;
    in property <length> overlay-height: 720px;
    in property <string> label;
    callback confirm;
    callback close;

    width: root.overlay-width;
    height: root.overlay-height;
    background: Theme.overlay;
    TouchArea {
        clicked => { root.close(); }
    }
    card := Rectangle {
        width: 430px;
        height: 230px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dialog-shadow;
        drop-shadow-offset-y: 10px;
        TouchArea { }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: "卸载插件";
                font-size: 15px;
                font-weight: 700;
                color: Theme.danger;
            }
            Text {
                text: "确定卸载 " + root.label + "？";
                font-size: 12px;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: "只删除插件包与注册信息，不删除该 agent 的本地会话数据。";
                font-size: 11px;
                color: Theme.text3;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                ActionButton {
                    text: "取消";
                    clicked => { root.close(); }
                }
                ActionButton {
                    text: "卸载";
                    danger: true;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
