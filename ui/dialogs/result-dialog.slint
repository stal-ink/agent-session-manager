import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action-button.slint";

export component ResultDialog inherits Rectangle {
    in property <length> overlay-width: 1080px;
    in property <length> overlay-height: 720px;
    in property <string> title;
    in property <string> message;
    in property <bool> cancel-visible: true;
    callback confirm;
    callback cancel;

    width: root.overlay-width;
    height: root.overlay-height;
    background: Theme.overlay;
    TouchArea {
        clicked => { root.cancel(); }
    }
    card := Rectangle {
        width: 420px;
        height: 220px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dialog-shadow;
        drop-shadow-offset-y: 10px;
        TouchArea { }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
            }
            message-scroll := ScrollView {
                vertical-stretch: 1;
                Text {
                    width: message-scroll.content-width;
                    text: root.message;
                    font-size: 12px;
                    color: Theme.text2;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.cancel-visible : ActionButton {
                    text: "取消";
                    clicked => { root.cancel(); }
                }
                ActionButton {
                    text: "确定";
                    primary: true;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
