import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { PluginDownloadRow, UpdateLogRow } from "../types.slint";

// 通用信息浮层：两个页签 + 可滚动日志，Agent 管理与插件页共用同一套设计。
// 位置与开关由页面控制；指针进入时通过 hover-changed(true) 让页面保持打开。
export component InfoPopover inherits Rectangle {
    in property <string> first-tab-label: "下载";
    in property <string> second-tab-label: "检查";
    in property <string> first-tab-text: "";
    in property <bool> checking: false;
    in property <[UpdateLogRow]> log;
    in property <[PluginDownloadRow]> downloads;
    callback hover-changed(bool);

    property <int> tab: 1;
    border-radius: 12px;
    background: Theme.dialog-bg;
    border-width: 1px;
    border-color: Theme.dialog-border;
    drop-shadow-blur: 28px;
    drop-shadow-color: Theme.dialog-shadow;
    drop-shadow-offset-y: 8px;
    popover-hover := TouchArea {
        changed has-hover => { root.hover-changed(self.has-hover); }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 64px;
                height: 24px;
                border-radius: 6px;
                background: root.tab == 0 ? Theme.accent-soft : transparent;
                Text {
                    text: root.first-tab-label;
                    font-size: 11.5px;
                    color: root.tab == 0 ? Theme.accent-text : Theme.text2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.tab = 0; }
                }
            }
            Rectangle {
                width: 64px;
                height: 24px;
                border-radius: 6px;
                background: root.tab == 1 ? Theme.accent-soft : transparent;
                Text {
                    text: root.second-tab-label;
                    font-size: 11.5px;
                    color: root.tab == 1 ? Theme.accent-text : Theme.text2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.tab = 1; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        if root.tab == 0 : VerticalLayout {
            if root.downloads.length == 0 : VerticalLayout {
                alignment: center;
                Text {
                    text: root.first-tab-text;
                    font-size: 12px;
                    color: Theme.text3;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            if root.downloads.length > 0 : ListView {
                vertical-stretch: 1;
                for row in root.downloads : Rectangle {
                    height: 38px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            Text {
                                text: row.label;
                                font-size: 11.5px;
                                color: Theme.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: row.detail;
                                font-size: 11px;
                                color: row.done ? Theme.tag-active-text : Theme.text3;
                            }
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.border;
                            Rectangle {
                                width: parent.width * Math.max(0.0, Math.min(1.0, row.progress));
                                height: parent.height;
                                border-radius: 1.5px;
                                background: row.done ? Theme.tag-active-text : Theme.accent;
                            }
                        }
                    }
                }
            }
        }
        if root.tab == 1 : VerticalLayout {
            spacing: 6px;
            if root.checking : Text {
                text: "正在检查…";
                font-size: 11.5px;
                color: Theme.accent-text;
            }
            ListView {
                vertical-stretch: 1;
                for entry in root.log : Text {
                    height: 20px;
                    text: entry.text;
                    font-size: 11.5px;
                    color: !entry.ok ? Theme.danger : (entry.updatable ? Theme.tag-active-text : Theme.text2);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.log.length == 0 && !root.checking : Text {
                text: "还没有检查记录";
                font-size: 11.5px;
                color: Theme.text3;
            }
        }
    }
}
