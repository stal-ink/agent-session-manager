export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon-app.svg");
    tooltip: "Agent Session Manager";
    callback show-window;
    callback quit;
    clicked => { root.show-window(); }
    Menu {
        MenuItem {
            title: "显示主界面";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "退出";
            activated => { root.quit(); }
        }
    }
}
