import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { OpenDefaultRow, ThemeCard } from "../types.slint";
import { ActionButton } from "../components/action-button.slint";
import { IconTile } from "../components/icon-tile.slint";
import { Select } from "../components/select.slint";

// 设置整页：覆盖主界面与左侧栏，Esc 或"返回应用"回到主界面。
// 布局参照参考样式：左栏自上而下为 返回应用、搜索框、分组菜单（带图标）；
// 内容区为大标题 + 说明 + 组标签在卡片外、卡片内是设置行（名称加粗 + 灰色说明 + 控件）。
// 所有改动即时保存到 config.json，不设保存按钮。

component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.accent : Theme.surface2;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border-strong;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        animate x { duration: 120ms; }
    }
    TouchArea {
        clicked => { root.toggled(!root.on); }
    }
}

// 设置卡片：无边框圆角容器，组标签在卡片外，卡片内只有设置行。
component SettingCard inherits Rectangle {
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        @children
    }
}

// 左栏菜单项：图标 + 文字，选中态 accent 底。
component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked;

    height: 34px;
    border-radius: 8px;
    background: selected ? Theme.accent-soft : (touch.has-hover ? Theme.surface2 : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                image-fit: contain;
                colorize: root.selected ? Theme.accent-text : Theme.text2;
            }
        }
        Text {
            text: root.label;
            font-size: 12.5px;
            color: selected ? Theme.accent-text : Theme.text2;
            font-weight: selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    in-out property <string> section: "appearance";
    in-out property <string> search-text;
    in property <bool> match-appearance: true;
    in property <bool> match-export: true;
    in property <bool> match-transfer: true;
    in property <bool> match-open: true;
    in property <bool> match-update: true;
    in property <bool> match-data: true;
    in property <string> theme-choice: "system";
    in property <[ThemeCard]> theme-cards;
    in property <bool> wallpaper-set: false;
    in property <bool> normal-tool-results: true;
    in property <bool> handoff-tool-results: true;
    in property <bool> compaction-only: false;
    in property <bool> auto-check: true;
    in property <[OpenDefaultRow]> open-defaults;
    in property <string> app-version: "";
    in property <string> app-update-button-text: "检查软件更新";
    in property <bool> app-update-button-enabled: true;
    in property <string> app-update-detail: "";
    in property <float> app-update-progress: 0;
    in property <string> app-update-speed: "";
    in property <string> app-update-last-check: "";
    callback back;
    callback app-update-clicked;
    callback theme-changed(string);
    callback wallpaper-choose;
    callback tool-toggled(string, bool);
    callback compaction-toggled(bool);
    callback auto-check-toggled(bool);
    callback open-default-changed(string, string);
    callback open-dir(string);
    callback search-changed(string);

    // Esc 返回主界面：页面挂载即持有焦点。
    init => { scope.focus(); }

    property <bool> any-match: root.match-appearance || root.match-export || root.match-transfer || root.match-open || root.match-update || root.match-data;

    scope := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.back();
                accept
            } else {
                reject
            }
        }
    }

    HorizontalLayout {
        width: root.width;
        height: root.height;
        spacing: 0;

        // 左栏 220px：返回应用、搜索、分组菜单
        Rectangle {
            width: 220px;
            background: Theme.surface;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 6px;
                // 返回应用
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: back-touch.has-hover ? Theme.surface2 : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/icon-back.svg");
                                width: 15px;
                                height: 15px;
                                image-fit: contain;
                                colorize: Theme.text2;
                            }
                        }
                        Text {
                            text: "返回应用";
                            font-size: 12.5px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    back-touch := TouchArea {
                        clicked => { root.back(); }
                    }
                }
                Rectangle { height: 6px; }
                // 搜索框：放大镜图标 + 输入
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.input-bg;
                    Image {
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../assets/icons/icon-search.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: Theme.text3;
                    }
                    TextInput {
                        x: 32px;
                        width: parent.width - 42px;
                        height: parent.height;
                        text <=> root.search-text;
                        color: Theme.text;
                        font-size: 12px;
                        single-line: true;
                        selection-background-color: Theme.accent;
                        vertical-alignment: center;
                        changed text => { root.search-changed(self.text); }
                    }
                    if root.search-text == "" : Text {
                        x: 33px;
                        y: (parent.height - self.height) / 2;
                        text: "搜索设置…";
                        color: Theme.text3;
                        font-size: 12px;
                    }
                }
                Rectangle { height: 10px; }
                if root.match-appearance || root.match-export || root.match-transfer || root.match-open || root.match-update : Text {
                    text: "个人";
                    font-size: 10.5px;
                    color: Theme.text-faint;
                }
                if root.match-appearance : MenuEntry {
                    label: "外观";
                    icon: @image-url("../../assets/icons/icon-appearance.svg");
                    selected: root.section == "appearance";
                    clicked => { root.section = "appearance"; }
                }
                if root.match-export : MenuEntry {
                    label: "导出与交接";
                    icon: @image-url("../../assets/icons/icon-export.svg");
                    selected: root.section == "export";
                    clicked => { root.section = "export"; }
                }
                if root.match-transfer : MenuEntry {
                    label: "转接";
                    icon: @image-url("../../assets/icons/icon-transfer.svg");
                    selected: root.section == "transfer";
                    clicked => { root.section = "transfer"; }
                }
                if root.match-open : MenuEntry {
                    label: "打开";
                    icon: @image-url("../../assets/icons/icon-open.svg");
                    selected: root.section == "open";
                    clicked => { root.section = "open"; }
                }
                if root.match-update : MenuEntry {
                    label: "更新";
                    icon: @image-url("../../assets/icons/icon-update.svg");
                    selected: root.section == "update";
                    clicked => { root.section = "update"; }
                }
                if root.match-data : Text {
                    text: "关于";
                    font-size: 10.5px;
                    color: Theme.text-faint;
                }
                if root.match-data : MenuEntry {
                    label: "数据与关于";
                    icon: @image-url("../../assets/icons/icon-data.svg");
                    selected: root.section == "data";
                    clicked => { root.section = "data"; }
                }
                Rectangle { vertical-stretch: 1; }
                if !root.any-match : Text {
                    text: "没有匹配的设置";
                    font-size: 12px;
                    color: Theme.text3;
                }
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // 内容区：大标题 + 说明 + 组（标签在卡片外）
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;
            // 内容纵向：滚动区 + 底部页脚
            VerticalLayout {
                ScrollView {
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            width: 760px;
                            // 内容从顶部排列，禁止垂直拉伸把标题/说明/卡片甩散
                            alignment: start;
                            padding-top: 28px;
                            padding-bottom: 28px;
                            spacing: 16px;

                            // ── 外观 ──
                            if root.section == "appearance" && root.match-appearance : VerticalLayout {
                                alignment: start;
                                spacing: 16px;
                            Text {
                                text: "外观";
                                font-size: 19px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "选择应用主题，切换即时生效。";
                                font-size: 12px;
                                color: Theme.text3;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            FlexboxLayout {
                                spacing: 10px;
                                for card in root.theme-cards : Rectangle {
                                    width: 246px;
                                    height: 104px;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: root.theme-choice == card.id ? Theme.accent : Theme.border;
                                    background: root.theme-choice == card.id ? Theme.accent-soft : Theme.card;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        alignment: start;
                                        // 迷你窗口预览：底色 + 侧栏块 + 强调条；壁纸主题显示图片图标。
                                        Rectangle {
                                            width: 64px;
                                            height: 36px;
                                            border-radius: 6px;
                                            background: card.swatch-bg;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            clip: true;
                                            if card.wallpaper : Image {
                                                width: 20px;
                                                height: 20px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/icons/icon-wallpaper.svg");
                                                image-fit: contain;
                                                colorize: card.swatch-text;
                                            }
                                            if !card.wallpaper : Rectangle {
                                                x: 6px;
                                                y: 6px;
                                                width: 18px;
                                                height: 24px;
                                                border-radius: 3px;
                                                background: card.swatch-surface;
                                            }
                                            if !card.wallpaper : Rectangle {
                                                x: 29px;
                                                y: 9px;
                                                width: 26px;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: card.swatch-text;
                                            }
                                            if !card.wallpaper : Rectangle {
                                                x: 29px;
                                                y: 17px;
                                                width: 16px;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: card.swatch-accent;
                                            }
                                        }
                                        Text {
                                            text: card.label;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: root.theme-choice == card.id ? Theme.accent-text : Theme.text;
                                        }
                                        Text {
                                            text: card.description;
                                            font-size: 10.5px;
                                            color: Theme.text3;
                                            wrap: no-wrap;
                                            overflow: elide;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.theme-changed(card.id); }
                                    }
                                }
                            }
                            if root.theme-choice == "wallpaper" : Rectangle {
                                height: 56px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.card;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    cross-axis-alignment: center;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;
                                        Text {
                                            text: "壁纸图片";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: root.wallpaper-set
                                                ? "已选择，导入时自动校正方向并裁剪为 2560×1600"
                                                : "未选择图片，壁纸使用纯色底";
                                            font-size: 10.5px;
                                            color: Theme.text3;
                                            wrap: no-wrap;
                                            overflow: elide;
                                        }
                                    }
                                    ActionButton {
                                        text: root.wallpaper-set ? "更换图片" : "选择图片";
                                        primary: true;
                                        clicked => { root.wallpaper-choose(); }
                                    }
                                }
                            }
                        }

                        // ── 导出与交接 ──
                        if root.section == "export" && root.match-export : VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Text {
                                text: "导出与交接";
                                font-size: 19px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "普通文档与交接文档各提供一项导出设置。";
                                font-size: 12px;
                                color: Theme.text3;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            Text {
                                text: "普通文档导出设置";
                                font-size: 11.5px;
                                color: Theme.text3;
                            }
                            SettingCard {
                                height: 84px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text {
                                            text: "导出工具调用结果";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: "关闭后仍保留工具名与参数，不写结果正文。";
                                            font-size: 11.5px;
                                            color: Theme.text3;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            on: root.normal-tool-results;
                                            toggled(value) => { root.tool-toggled("normal", value); }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "交接文档导出设置";
                                font-size: 11.5px;
                                color: Theme.text3;
                            }
                            SettingCard {
                                height: 84px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text {
                                            text: "导出工具调用结果";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: "关闭后交接文档只保留工具名与参数。";
                                            font-size: 11.5px;
                                            color: Theme.text3;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            on: root.handoff-tool-results;
                                            toggled(value) => { root.tool-toggled("handoff", value); }
                                        }
                                    }
                                }
                            }
                        }

                        // ── 转接 ──
                        if root.section == "transfer" && root.match-transfer : VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Text {
                                text: "转接设置";
                                font-size: 19px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "原生转接与注入的默认行为。";
                                font-size: 12px;
                                color: Theme.text3;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            Text {
                                text: "原生转接设置";
                                font-size: 11.5px;
                                color: Theme.text3;
                            }
                            SettingCard {
                                height: 84px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text {
                                            text: "仅注入最近压缩之后的消息";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: "开启后原生注入以最近一次压缩为边界，之前的对话不再写入目标端。";
                                            font-size: 11.5px;
                                            color: Theme.text3;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            on: root.compaction-only;
                                            toggled(value) => { root.compaction-toggled(value); }
                                        }
                                    }
                                }
                            }
                        }

                        // ── 打开 ──
                        if root.section == "open" && root.match-open : VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Text {
                                text: "打开";
                                font-size: 19px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "可打开形态 ≥ 2 的产品可指定默认打开；只有 1 个可打开形态时不显示。";
                                font-size: 12px;
                                color: Theme.text3;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            for item in root.open-defaults : SettingCard {
                                height: 84px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconTile {
                                            source: item.icon;
                                            width: 30px;
                                            height: 30px;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: item.label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: item.summary;
                                            font-size: 10.5px;
                                            color: Theme.text3;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;
                                            Text {
                                                text: "默认打开";
                                                font-size: 10.5px;
                                                color: Theme.text2;
                                                vertical-alignment: center;
                                            }
                                            Select {
                                                width: 250px;
                                                options: item.options;
                                                value: item.current;
                                                changed(label) => { root.open-default-changed(item.product, label); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── 更新 ──
                        if root.section == "update" && root.match-update : VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Text {
                                text: "更新";
                                font-size: 19px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "更新检查的时机与周期。";
                                font-size: 12px;
                                color: Theme.text3;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            Text {
                                text: "检查";
                                font-size: 11.5px;
                                color: Theme.text3;
                            }
                            SettingCard {
                                height: 84px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text {
                                            text: "自动检查更新";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: "检查软件本体、插件与 Agent 版本：启动时一次，之后每 20 分钟一次；关闭后只手动。";
                                            font-size: 11.5px;
                                            color: Theme.text3;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            on: root.auto-check;
                                            toggled(value) => { root.auto-check-toggled(value); }
                                        }
                                    }
                                }
                            }
                        }

                        // ── 数据与关于 ──
                        if root.section == "data" && root.match-data : VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Text {
                                text: "数据与关于";
                                font-size: 19px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "数据目录、备份、导出与应用信息。";
                                font-size: 12px;
                                color: Theme.text3;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            Text {
                                text: "数据目录";
                                font-size: 11.5px;
                                color: Theme.text3;
                            }
                            SettingCard {
                                height: 96px;
                                Text {
                                    text: "配置、备份与导出都在应用数据目录下。";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        text: "打开数据目录";
                                        clicked => { root.open-dir("data"); }
                                    }
                                    ActionButton {
                                        text: "打开备份目录";
                                        clicked => { root.open-dir("backup"); }
                                    }
                                    ActionButton {
                                        text: "打开导出目录";
                                        clicked => { root.open-dir("exports"); }
                                    }
                                    ActionButton {
                                        text: "打开插件目录";
                                        clicked => { root.open-dir("plugins"); }
                                    }
                                }
                            }
                            Text {
                                text: "关于";
                                font-size: 11.5px;
                                color: Theme.text3;
                            }
                            SettingCard {
                                height: 188px;
                                HorizontalLayout {
                                    Text {
                                        text: "应用版本";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: "v" + root.app-version;
                                        font-size: 12px;
                                        color: Theme.text2;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "Agent Session Manager · 在不同 AI agent 之间转接会话";
                                    font-size: 11.5px;
                                    color: Theme.text3;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: "软件更新";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: root.app-update-detail;
                                            font-size: 11.5px;
                                            color: Theme.text3;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.app-update-last-check;
                                            font-size: 10.5px;
                                            color: Theme.text-faint;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            width: 118px;
                                            text: root.app-update-button-text;
                                            enabled: root.app-update-button-enabled;
                                            primary: root.app-update-button-enabled;
                                            clicked => { root.app-update-clicked(); }
                                        }
                                    }
                                }
                                if root.app-update-progress > 0:
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.surface2;
                                    Rectangle {
                                        width: parent.width * root.app-update-progress;
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }
                                if root.app-update-speed != "":
                                Text {
                                    text: root.app-update-speed;
                                    font-size: 10.5px;
                                    color: Theme.text-faint;
                                }
                            }
                        }
                    }
                }
            }
                // 底部：即时保存说明（线稿页脚横线）
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            width: 760px;
                            alignment: start;
                            spacing: 13px;
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            Text {
                                text: "设置即时保存；返回应用后生效。";
                                font-size: 10.5px;
                                color: Theme.text-faint;
                            }
                        }
                    }
                }
            }
        }
    }
}
